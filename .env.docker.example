APP_NAME="Jira Worklog Bot"
APP_ENV=production
# Optional for local Docker Compose. When empty, Compose generates a persistent
# key in its private Docker volume. Always set APP_KEY explicitly in production.
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Ho_Chi_Minh

LOG_CHANNEL=stderr
LOG_LEVEL=info

SESSION_DRIVER=cookie
SESSION_SECURE_COOKIE=false
CACHE_STORE=array
QUEUE_CONNECTION=sync

JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
